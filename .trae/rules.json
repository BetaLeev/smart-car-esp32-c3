{
  "version": "1.1",
  "name": "ESP32-C3 Smart Car Rules",
  "description": "智能小车项目开发规范 - 模块化、高可维护性",
  "rules": {
    "branch": {
      "naming": {
        "pattern": "^(main|develop|feature/[a-z0-9-]+|fix/[a-z0-9-]+|release/[0-9.]+)$",
        "description": "分支名格式: main, develop, feature/*, fix/*, release/*"
      },
      "protection": {
        "main": {
          "require_review": true,
          "require_tests": false,
          "force_push": false
        },
        "develop": {
          "require_review": false,
          "force_push": false
        }
      }
    },
    "commit": {
      "pattern": "^(feat|fix|docs|style|refactor|test|chore)(\\([a-z_-]+\\))?: .{1,50}",
      "description": "格式: type(module): description",
      "types": ["feat", "fix", "docs", "style", "refactor", "test", "chore"]
    },
    "esp32_compatibility": {
      "description": "ESP32 芯片兼容性规则 - 避免使用仅在特定芯片上可用的 API",
      "chip_specific_restrictions": {
        "esp32_c3": {
          "description": "ESP32-C3 是单核 RISC-V 芯片，无 PSRAM，无传统 Wi-Fi NVS 安全存储",
          "prohibited_functions": {
            "esp_get_heap_size": "使用 heap_caps_get_total_size(MALLOC_CAP_8BIT) 替代",
            "esp_spiram_is_initialized": "ESP32-C3 无 PSRAM，删除相关代码",
            "esp_chip_info": "需要 esp_chip_info.h，且功能有限"
          },
          "safe_alternatives": {
            "total_heap": "heap_caps_get_total_size(MALLOC_CAP_8BIT)",
            "heap_check": "heap_caps_check_integrity_all()"
          }
        },
        "esp32_s2": {
          "description": "ESP32-S2 支持 PSRAM",
          "prohibited_functions": {}
        },
        "esp32_s3": {
          "description": "ESP32-S3 支持 PSRAM 和 AI 加速器",
          "prohibited_functions": {}
        },
        "esp32": {
          "description": "原版 ESP32 双核芯片",
          "prohibited_functions": {}
        }
      },
      "checklist": {
        "before_using_new_api": [
          "查阅 ESP-IDF 编程指南确认函数可用性",
          "检查 CONFIG_SOC_* 宏确认芯片支持",
          "使用条件编译 #ifdef CONFIG_IDF_TARGET_ESP32C3 保护特定芯片代码",
          "查看 esp-idf/components/esp_system/include/esp_chip_info.h",
          "确认函数不在 prohibited_functions 列表中"
        ],
        "memory_apis": {
          "safe": [
            "esp_get_free_heap_size()",
            "esp_get_minimum_free_heap_size()",
            "heap_caps_get_free_size()",
            "heap_caps_get_total_size()",
            "heap_caps_check_integrity_all()"
          ],
          "unsafe_esp32c3": [
            "esp_get_heap_size() - 使用 heap_caps_get_total_size() 替代",
            "esp_spiram_* - ESP32-C3 无 PSRAM"
          ]
        }
      },
      "required_headers": {
        "esp_get_free_heap_size": "esp_system.h",
        "heap_caps_*": "esp_heap_caps.h",
        "esp_chip_info": "esp_chip_info.h"
      }
    },
    "code": {
      "structure": {
        "modules": ["wifi", "web", "motor", "control", "config", "utils"],
        "description": "每个模块独立，包含 .c 和 .h 文件"
      },
      "naming": {
        "files": "snake_case",
        "functions": "module_action",
        "variables": "snake_case",
        "constants": "UPPER_SNAKE_CASE",
        "macros": "UPPER_SNAKE_CASE"
      },
      "style": {
        "indent": 3,
        "max_line_length": 100,
        "brace_style": "separate_line"
      }
    },
    "modules": {
      "wifi": {
        "prefix": "wifi_",
        "files": ["wifi_manager.c", "wifi_manager.h"]
      },
      "web": {
        "prefix": "web_",
        "files": ["web_server.c", "web_server.h", "routes.c", "routes.h"]
      },
      "motor": {
        "prefix": "motor_",
        "files": ["motor_driver.c", "motor_driver.h", "motor_config.h"]
      },
      "control": {
        "prefix": "car_",
        "files": ["car_control.c", "car_control.h", "commands.h"]
      }
    }
  },
  "skills": [
    {
      "name": "esp32_review",
      "file": ".trae/skills/esp32_review.md",
      "description": "ESP32 内存安全与堆栈代码审查规范"
    },
    {
      "name": "esp32_fix",
      "file": ".trae/skills/esp32_fix.md",
      "description": "ESP32 内存泄漏与资源释放修复规范"
    },
    {
      "name": "esp32_code_review_rules",
      "file": ".trae/rules/esp32_code_review_rules.md",
      "description": "ESP32-C3 智能小车项目全方位代码审查规范（7大维度）"
    }
  ]
}
