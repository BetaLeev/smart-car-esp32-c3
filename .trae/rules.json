{
  "version": "1.0",
  "name": "ESP32-C3 Smart Car Rules",
  "description": "智能小车项目开发规范 - 模块化、高可维护性",
  "rules": {
    "branch": {
      "naming": {
        "pattern": "^(main|develop|feature/[a-z0-9-]+|fix/[a-z0-9-]+|release/[0-9.]+)$",
        "description": "分支名格式: main, develop, feature/*, fix/*, release/*"
      },
      "protection": {
        "main": {
          "require_review": true,
          "require_tests": false,
          "force_push": false
        },
        "develop": {
          "require_review": false,
          "force_push": false
        }
      }
    },
    "commit": {
      "pattern": "^(feat|fix|docs|style|refactor|test|chore)(\\([a-z_-]+\\))?: .{1,50}",
      "description": "格式: type(module): description",
      "types": ["feat", "fix", "docs", "style", "refactor", "test", "chore"]
    },
    "code": {
      "structure": {
        "modules": ["wifi", "web", "motor", "control", "config", "utils"],
        "description": "每个模块独立，包含 .c 和 .h 文件"
      },
      "naming": {
        "files": "snake_case",
        "functions": "module_action",
        "variables": "snake_case",
        "constants": "UPPER_SNAKE_CASE",
        "macros": "UPPER_SNAKE_CASE"
      },
      "style": {
        "indent": 3,
        "max_line_length": 100,
        "brace_style": "separate_line"
      }
    },
    "modules": {
      "wifi": {
        "prefix": "wifi_",
        "files": ["wifi_manager.c", "wifi_manager.h"]
      },
      "web": {
        "prefix": "web_",
        "files": ["web_server.c", "web_server.h", "routes.c", "routes.h"]
      },
      "motor": {
        "prefix": "motor_",
        "files": ["motor_driver.c", "motor_driver.h", "motor_config.h"]
      },
      "control": {
        "prefix": "car_",
        "files": ["car_control.c", "car_control.h", "commands.h"]
      }
    }
  }
}
